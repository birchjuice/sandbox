[server]
http_addr = 127.0.0.1
http_port = {{ grafana_port }}
domain = grafana.{{ apps_subdomain }}.{{ domain_name }}
root_url = https://grafana.{{ apps_subdomain }}.{{ domain_name }}

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}

[auth.generic_oauth]
enabled = true
name = Keycloak
allow_sign_up = true
auto_login = false
client_id = grafana
client_secret = {{ grafana_keycloak_client_secret }}
scopes = openid profile email
auth_url = https://auth.apps.lab.local/realms/lab/protocol/openid-connect/auth
token_url = https://auth.apps.lab.local/realms/lab/protocol/openid-connect/token
api_url = https://auth.apps.lab.local/realms/lab/protocol/openid-connect/userinfo
login_attribute_path = preferred_username
name_attribute_path = name
email_attribute_path = email
