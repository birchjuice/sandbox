server {
    listen 8080;
    server_name _;

    location = /stub_status {
        stub_status;
    }
}

server {
    listen 80 default_server;
    server_name _;

    return 444;
}

server {
    listen 80;
    server_name gitea.{{ apps_subdomain }}.{{ domain_name }}
                grafana.{{ apps_subdomain }}.{{ domain_name }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name gitea.{{ apps_subdomain }}.{{ domain_name }};

    ssl_certificate /etc/nginx/tls/apps.crt;
    ssl_certificate_key /etc/nginx/tls/apps.key;

    location / {
        proxy_pass http://localhost:{{ gitea_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    server_name grafana.{{ apps_subdomain }}.{{ domain_name }};

    ssl_certificate /etc/nginx/tls/apps.crt;
    ssl_certificate_key /etc/nginx/tls/apps.key;

    location / {
        proxy_pass http://localhost:{{ grafana_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
