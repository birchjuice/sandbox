options {
    directory "/var/cache/bind";

    recursion yes;

    allow-query {
        any;
    };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };

    dnssec-validation auto;

    listen-on {
        any;
    };

    listen-on-v6 {
        none;
    };
};

statistics-channels {
        inet 127.0.0.1 port 8053 allow { 127.0.0.1; };
};
