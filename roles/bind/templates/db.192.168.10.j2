$TTL    604800
@       IN      SOA     ns1.{{ apps_subdomain }}.{{ domain_name }}.  admin.{{ apps_subdomain }}.{{ domain_name }}. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns1.{{ apps_subdomain }}.{{ domain_name }}.
{{ ansible_host.split('.')[-1] }}  IN  PTR  {{ inventory_hostname }}.{{ apps_subdomain }}.{{ domain_name }}.
