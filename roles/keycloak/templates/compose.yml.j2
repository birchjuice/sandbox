services:
  db:
    image: postgres:{{ postgres_version }}
    container_name: postgres
    restart: unless-stopped
    mem_limit: 256m

    environment:
      POSTGRES_DB: {{ keycloak_db_name | to_json }}
      POSTGRES_USER: {{ keycloak_db_user | to_json }}
      POSTGRES_PASSWORD: {{ keycloak_db_password | replace('$', '$$') | to_json }}

    volumes:
      - keycloak_db:/var/lib/postgresql/data

    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U {{ keycloak_db_user }} -d {{ keycloak_db_name }}']
      interval: 10s
      timeout: 5s
      retries: 5

  server:
    image: quay.io/keycloak/keycloak:{{ keycloak_version }}
    container_name: keycloak
    restart: unless-stopped
    mem_limit: 1g

    depends_on:
      db:
        condition: service_healthy

    environment:
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://db:5432/{{ keycloak_db_name }}
      KC_DB_USERNAME: {{ keycloak_db_user | to_json }}
      KC_DB_PASSWORD: {{ keycloak_db_password | replace('$', '$$') | to_json }}

      KC_HOSTNAME: https://auth.{{ apps_subdomain }}.{{ domain_name }}
      KC_HTTP_ENABLED: 'true'
      KC_PROXY_HEADERS: xforwarded

      KC_BOOTSTRAP_ADMIN_USERNAME: {{ keycloak_admin_user | to_json }}
      KC_BOOTSTRAP_ADMIN_PASSWORD: {{ keycloak_admin_password | replace('$', '$$') | to_json }}

      KC_VAULT: file
      KC_VAULT_DIR: /opt/keycloak/conf/vault

    ports:
      - 127.0.0.1:{{ keycloak_http_port }}:8080

    volumes:
      - ./truststore:/opt/keycloak/conf/truststores:ro
      - ./vault:/opt/keycloak/conf/vault:ro
      - ./realm-import:/opt/keycloak/data/import:ro

    command: start --import-realm

volumes:
  keycloak_db:
