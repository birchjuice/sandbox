global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:{{ prometheus_port }}

  - job_name: node
    static_configs:
      - targets:
          - localhost:{{ node_exporter_port }}

  - job_name: bind
    static_configs:
      - targets:
          - localhost:{{ bind_exporter_port }}

  - job_name: nginx
    static_configs:
      - targets:
          - localhost:{{ nginx_exporter_port }}

  - job_name: gitea
    static_configs:
      - targets:
          - localhost:{{ gitea_http_port }}

  - job_name: docker
    static_configs:
      - targets:
          - localhost:{{ cadvisor_port }}
